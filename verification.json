{
  "mod_id": "hfr",
  "base_package": "com.hfr",
  "display_name": "Xenofactions",
  "archive_pattern": "{mod_id}-{full_version}+mc{mc}-{loader}.jar",
  "version_class": "{package_path}/BuildVersion.class",
  "required_classes": [],
  "required_shared_classes": [
    "com/hfr/tdm/BlockAreaEdges.class",
    "com/hfr/clowder/FactionRole.class",
    "com/hfr/clowder/FactionMemberRecord.class"
  ],
  "class_roots": [
    "com/hfr/",
    "cofh/api/"
  ],
  "resource_roots": [
    "assets/{mod_id}/",
    "data/{mod_id}/"
  ],
  "required_assets": [],
  "metadata_profiles": {
    "legacy": {
      "path": "mcmod.info",
      "json_values": {
        "0.modid": "{mod_id}",
        "0.name": "{display_name}",
        "0.version": "{full_version}",
        "0.mcversion": "{mc}"
      }
    },
    "forge": {
      "path": "META-INF/mods.toml",
      "sections": [
        {
          "table": "",
          "fields": {
            "modLoader": "javafml",
            "loaderVersion": "{fml_range}"
          }
        },
        {
          "table": "mods",
          "fields": {
            "modId": "{mod_id}",
            "version": "{full_version}",
            "displayName": "{display_name}"
          }
        },
        {
          "table": "dependencies.{mod_id}",
          "fields": {
            "modId": "{loader}",
            "versionRange": "{loader_range}",
            "mandatory": true
          }
        },
        {
          "table": "dependencies.{mod_id}",
          "fields": {
            "modId": "minecraft",
            "versionRange": "[{mc}]",
            "mandatory": true
          }
        }
      ]
    }
  },
  "targets": {
    "1.7.10": {
      "metadata_profile": "legacy",
      "block_textures": "blocks",
      "item_textures": "items",
      "language_file": "en_US.lang",
      "required_classes": [
        "com/hfr/main/MainRegistry.class",
        "com/hfr/data/ClowderData.class",
        "com/hfr/tdm/TDMManager.class",
        "com/hfr/shop/XShopService.class",
        "com/hfr/client/journeymap/JourneyMap6Plugin.class"
      ],
      "json_checks": [],
      "remapping": {
        "required": true,
        "checks": [
          {
            "class": "com/hfr/command/CommandClowder.class",
            "present": [
              "func_71518_a"
            ],
            "absent": [
              "getCommandName"
            ]
          }
        ]
      },
      "required_assets": [
        "assets/hfr/lang/en_US.lang",
        "assets/hfr/sounds.json",
        "assets/hfr/textures/logo.png"
      ]
    },
    "1.16.5": {
      "metadata_profile": "forge",
      "block_textures": "block",
      "item_textures": "item",
      "language_file": "en_us.json",
      "required_classes": [
        "com/hfr/main/Xenofactions.class",
        "com/hfr/data/FactionSavedData.class",
        "com/hfr/network/FoundationNetwork.class",
        "com/hfr/client/FoundationScreen.class"
      ],
      "json_checks": [
        {
          "path": "assets/hfr/models/item/item.world_border_wand.json",
          "values": {
            "parent": "item/generated",
            "textures.layer0": "hfr:item/world_border_wand"
          }
        },
        {
          "path": "pack.mcmeta",
          "values": {
            "pack.pack_format": 6,
            "pack.description": "Xenofactions resources"
          }
        }
      ],
      "remapping": {
        "required": true,
        "checks": [
          {
            "class": "com/hfr/command/FoundationCommands.class",
            "present": [
              "func_197030_a"
            ],
            "absent": [
              "literal"
            ]
          }
        ]
      },
      "fml_range": "[36,)",
      "loader_range": "[36.2.34,)",
      "required_assets": [
        "assets/hfr/lang/en_us.json",
        "assets/hfr/models/item/item.world_border_wand.json",
        "assets/hfr/textures/item/world_border_wand.png",
        "pack.mcmeta"
      ]
    }
  }
}
